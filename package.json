{
  "name": "getmnemo-anthropic",
  "version": "0.3.0",
  "description": "Mnemo helper for the Anthropic SDK — memory tool, prompt caching, and extended thinking wired together.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run && tsc -p tsconfig.typetest.json",
    "lint": "tsc --noEmit",
    "smoke": "node scripts/prod-smoke.mjs",
    "test:types": "tsc -p tsconfig.typetest.json"
  },
  "keywords": [
    "getmnemo",
    "anthropic",
    "claude",
    "memory",
    "tool-use",
    "prompt-caching"
  ],
  "author": {
    "name": "Mnemo",
    "url": "https://mnemohq.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ledgermem/getmnemo-anthropic.git"
  },
  "dependencies": {
    "getmnemo": "^0.6.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "homepage": "https://mnemohq.com"
}
